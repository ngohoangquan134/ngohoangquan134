<Project>
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2023</RevitVersion>
    <BaseIntermediateOutputPath Condition="'$(MSBuildProjectName)' == 'KetCauViet.Revit'">obj/$(RevitVersion)/</BaseIntermediateOutputPath>
    <NuGetLockFilePath Condition="'$(MSBuildProjectName)' == 'KetCauViet.Revit'">packages.$(RevitVersion).lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(MSBuildProjectName)' == 'KetCauViet.Revit' and '$(RevitApiPath)' != ''">obj/$(RevitVersion)/local-api.lock.json</NuGetLockFilePath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**;artifacts/**</DefaultItemExcludes>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
